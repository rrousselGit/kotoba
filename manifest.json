{
  "manifest_version": 3,
  "name": "Kotoba — Natural Japanese Vocabulary",
  "version": "1.4.0",
  "description": "Notice Japanese vocabulary naturally, learn new words with furigana, and keep a private encounter history.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://jisho.org/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Kotoba vocabulary", "default_popup": "popup.html" },
  "options_page": "options.html",
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["dictionary.js", "vendor/kuromoji.js", "content.js"], "css": ["styles.css"], "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "web_accessible_resources": [{ "resources": ["vendor/dict/*.dat.gz"], "matches": ["<all_urls>"] }]
}
